    "value": {
      "request": "yes"
    },
    "default": {
      "request": "yes"
    },
    "allowed": "dict:yes|no"
  },
  "agile_session": {
    "value": "no",
    "default": "no",
    "allowed": "yes|no"
  },
  "agile_session_restart_after_requests": {
    "value": 20,
    "default": 20,
    "allowed": "int>=1"
  },
  "failed_photos_keep": {
    "value": 5,
    "default": 5,
    "allowed": "int>=0"
  },
  "failed_photos_folder": {
    "value": "failed-photos",
    "default": "failed-photos",
    "allowed": "text"
  }
