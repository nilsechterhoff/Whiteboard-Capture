{
  "app_key": "<from the Dropbox app console; never commit>",
  "app_secret": "<from the Dropbox app console; never commit>",
  "refresh_token": "<written by setup_dropbox.py; never commit>",
  "models": {
    "haiku": "claude-haiku-5-5",
    "sonnet": "claude-sonnet-5-5",
    "opus": "claude-opus-5-5"
  },
  "camera_name": {
    "value": "",
    "default": "",
    "allowed": "any"
  },
  "default_model": {
    "value": "haiku",
    "default": "haiku",
    "allowed": "text"
  },
  "rotation_degrees": {
    "value": 0,
    "default": 0,
    "allowed": "0|90|180|270"
  },
  "dark_below": {
    "value": 20,
    "default": 20,
    "allowed": "int>=0"
  },
  "min_board_fill_percent": {
    "value": 50,
    "default": 50,
    "allowed": "0-100"
  },
  "jpeg_quality": {
    "value": 4,
    "default": 4,
    "allowed": "2-31"
  },
  "start_offset_seconds": {
    "value": 0.1,
    "default": 0.1,
    "allowed": "number>=0"
  },
  "selection_frame_delay_seconds": {
    "value": 2,
    "default": 2,
    "allowed": "number>=0"
  },
  "retry_pause_seconds": {
    "value": 1,
    "default": 1,
    "allowed": "number>=0"
  },
  "capture_retries": {
    "value": 2,
    "default": 2,
    "allowed": "int>=0"
  },
  "agile_idle_timeout_seconds": {
    "value": 600,
    "default": 600,
    "allowed": "int>=1"
  },
